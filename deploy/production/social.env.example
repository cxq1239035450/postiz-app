# Add these entries to deploy/production/config/.env on the server.
# Replace empty values with production credentials. Never commit actual secrets.
# TikTok: CLIENT_ID is the app's Client key.
TIKTOK_CLIENT_ID=''
TIKTOK_CLIENT_SECRET=''

# Facebook Page and Instagram (Facebook Business) share the main Meta app.
FACEBOOK_APP_ID=''
FACEBOOK_APP_SECRET=''

# YouTube uses OAuth client credentials (not a Google API key).
YOUTUBE_CLIENT_ID=''
YOUTUBE_CLIENT_SECRET=''

# Optional: enable only for Instagram (Standalone), using its own credentials.
# INSTAGRAM_APP_ID=''
# INSTAGRAM_APP_SECRET=''
